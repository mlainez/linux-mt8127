	/* NTC voltage to temperature, from the stock 10k thermistor table and divider. */
	battery_ntc: thermal-sensor-battery {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		#io-channel-cells = <0>;
		io-channels = <&pmic_adc MT6323_AUXADC_BATON1>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <
			(-20000) 997
			(-15000) 961
			(-10000) 921
			(-5000) 876
			0 827
			5000 774
			10000 720
			15000 664
			20000 608
			25000 553
			30000 500
			35000 450
			40000 403
			45000 359
			50000 320
			55000 283
			60000 251>;
	};

	thermal-zones {
		battery-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&battery_ntc>;
		};
	};

	fuel_gauge: fuel-gauge {
		compatible = "adc-battery";
		io-channels = <&pmic_adc MT6323_AUXADC_ISENSE>, <&battery_ntc>;
		io-channel-names = "voltage", "temperature";
		monitored-battery = <&battery>;
	};
};
